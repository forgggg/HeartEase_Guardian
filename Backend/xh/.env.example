APP_ENV=dev
AGENT_MODE=template
WENDIAN_MODE=mock
FENGHUO_MODE=mock
ADAPTER_TIMEOUT_SECONDS=3

# 以下配置仅为后续 LangChain 实现预留，当前 template 模式不会调用模型。
# 不要在此文件中填写或提交真实密钥。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
AGENT_RECURSION_LIMIT=10
MAX_SUGGESTIONS=3
