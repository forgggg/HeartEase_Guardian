# 复制为 Backend/pc/.env 或仓库根 .env（两处都会读取，就近优先）
# 任意 OpenAI 兼容服务均可：DeepSeek / 通义 / vLLM / 官方 OpenAI
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
# 客户端标识（部分网关按 UA 识别流量）
LLM_CLIENT_NAME=HeartEase-Guardian/0.1
# 需要会话头的网关（如 opencode zen/go）：填 x-opencode-session 与一个稳定会话 ID
LLM_SESSION_HEADER=
LLM_SESSION_ID=

# 留空则用仓库根 data/；也可填绝对路径
# DATA_DIR=
# DATA_MODE=auto            # auto（真实优先，缺字段用 mock）| real（缺数据报 503）| mock（只用 data/mock）
# IDENTITY_MODE=mock        # mock 时按 X-User-Id 识别；off 关闭校验（仅本地）
# RESUME_LLM_POLISH=off     # 5.1 是否调用模型润色，默认关闭

APP_ENV=dev
LOG_LEVEL=INFO
LOG_FILE=var/logs/app.log

# STORE_BACKEND=mysql
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/heart_ease_pc?charset=utf8mb4
# DB_POOL_SIZE=5
